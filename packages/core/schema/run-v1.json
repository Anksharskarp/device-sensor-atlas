{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sensor Atlas run v1",
  "type": "object",
  "required": [
    "version",
    "name",
    "channels",
    "samples"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "name": {
      "type": "string"
    },
    "channels": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "pattern": "\\S"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "quantity",
          "unit",
          "clock"
        ],
        "properties": {
          "quantity": {
            "type": "string",
            "pattern": "\\S"
          },
          "unit": {
            "type": "string",
            "pattern": "\\S"
          },
          "clock": {
            "type": "string",
            "pattern": "\\S"
          },
          "axis": {
            "type": "string"
          },
          "timestampKind": {
            "enum": [
              "source",
              "receipt"
            ]
          }
        }
      }
    },
    "samples": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "pattern": "\\S"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "t",
            "value",
            "segment"
          ],
          "properties": {
            "t": {
              "type": "number"
            },
            "value": {
              "type": "number"
            },
            "segment": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        }
      }
    },
    "trigger": {
      "type": "object",
      "required": [
        "channel",
        "edge",
        "level",
        "segment",
        "t"
      ],
      "properties": {
        "channel": {
          "type": "string",
          "pattern": "\\S"
        },
        "edge": {
          "enum": [
            "rising",
            "falling"
          ]
        },
        "level": {
          "type": "number"
        },
        "segment": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "t": {
          "type": "number"
        }
      }
    }
  }
}
