{
  "name": "@sensor-atlas/core",
  "version": "0.1.0-alpha.2",
  "description": "Record timestamped sensor readings, time oscillations, measure tilt and integrate irregular samples.",
  "author": "William Zhang",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Anksharskarp/device-sensor-atlas.git",
    "directory": "packages/core"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema/run-v1.json": "./schema/run-v1.json",
    "./websocket": {
      "types": "./dist/websocket.d.ts",
      "default": "./dist/websocket.js"
    }
  },
  "files": [
    "dist",
    "schema"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build"
  },
  "homepage": "https://anksharskarp.github.io/device-sensor-atlas/docs/",
  "bugs": {
    "url": "https://github.com/Anksharskarp/device-sensor-atlas/issues"
  },
  "keywords": [
    "sensor",
    "gyroscope",
    "accelerometer",
    "pendulum",
    "react-native"
  ]
}
